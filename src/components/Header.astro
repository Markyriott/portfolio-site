---
import { EMAIL_ADDRESS, GITHUB_URL, LINKEDIN_URL } from "../consts";
import Link from "./Link.astro";
---

<div class="flex gap-3">
    <div>
        <h1 class= "text-4xl font-bold">Kevin Harriott</h1>
        <p class="text-2xl">Software Engineer</p>
    </div>
    <div class= "space-x-2 mt-3">
        <Link href={EMAIL_ADDRESS} text="email" />
        <Link href={GITHUB_URL} text="github" />
        <Link href={LINKEDIN_URL} text="linkedin" />
    </div>
</div>