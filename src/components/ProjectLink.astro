---
import Link from "./Link.astro";

interface Props {
    project: {
        id: string,
        description: string,
        startDate: string,
        endDate?: string,
        demoLink?: string,
        repoLink?: string
    }
};

const { project } = Astro.props;
---

<div class="bg-gray-50 p-2 w-full max-w-4xl hover:bg-gray-100 hover:outline hover:outline-gray-400">
    <div class="flex gap-2 items-center flex-wrap">
        <p class="text-sm text-wrap text-gray-700">{project.startDate} — {project.endDate}</p>
        <span class="text-sm text-gray-400">|</span>
        <p class="text-md font-bold">{project.id}</p>
        <slot/>
    </div>
    <p class="text-md ml-2 text-wrap">{project.description}</p>
    <div class="flex ml-2 gap-2">
        {project.demoLink && <Link href={project.demoLink} text="demo" />}
        {project.repoLink && <Link href={project.repoLink} text="repo" />}
    </div>
</div>