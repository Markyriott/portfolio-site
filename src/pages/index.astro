---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import ProjectViewer from '../components/ProjectViewer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const title = SITE_TITLE;
const description = SITE_DESCRIPTION;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description}/>
	</head>
	<body>
		<main class="p-10 font-mono mx-auto max-w-fit flex flex-col min-h-screen">
			<Header />
			<div class="mt-5 max-w-3xl">
				<p class="text-md text-wrap">
					lorem ipsum dolor sit amet consectetur adipiscing elit in at autem non quos laboris pariatur et ut quod non et vel tempore velit proident ut sunt consequatur est corrupti officia ut molestias deleniti in maxime deleniti culpa qui provident labore corrupti nulla aliquip sed provident cumque qui amet ut fugiat	
				</p>
			</div>
			<ProjectViewer />
		</main>
	</body>
</html>
